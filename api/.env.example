# Copie para .env antes de rodar: cp .env.example .env
# Os valores abaixo são os do docker-compose (só para desenvolvimento).

PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://agendei:agendei@localhost:5432/agendei"

# RabbitMQ
RABBITMQ_URL="amqp://agendei:agendei@localhost:5672"

# E-mail: em desenvolvimento, o Mailpit recebe tudo (caixa de entrada em http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT=1025
MAIL_FROM="agendei <nao-responda@agendei.local>"
