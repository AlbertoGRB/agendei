# Copie para .env antes de rodar: cp .env.example .env
# Os valores abaixo são os do docker-compose (só para desenvolvimento).

PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://agendei:agendei@localhost:5432/agendei"

# RabbitMQ
RABBITMQ_URL="amqp://agendei:agendei@localhost:5672"

# E-mail: em desenvolvimento, o Mailpit recebe tudo (caixa de entrada em http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT=1025
# Usuário e senha do provedor de e-mail. O Mailpit não pede, então ficam vazios.
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="agendei <nao-responda@agendei.local>"

# Assina o token de acesso (JWT). Mínimo de 32 caracteres. Gere um valor com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=""

# Endereço do front. Só ele pode chamar a API pelo navegador (CORS).
WEB_URL="http://localhost:5173"

# Quantos proxies há na frente da API, para o limite de requisições contar
# por cliente. Fica vazio em desenvolvimento; no Railway, é 1.
TRUST_PROXY=""

# Só no deploy: o segredo que a Vercel manda no cabeçalho x-origin-secret.
# Com ele, a API confia no IP do cliente que a Vercel manda. Mínimo de 32
# caracteres, o mesmo valor na Vercel e no Railway.
ORIGIN_SECRET=""
